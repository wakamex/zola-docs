{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wakamex/zola-docs/blob/main/schemas/navigation.schema.json",
  "title": "Zola Docs navigation",
  "oneOf": [
    { "$ref": "#/$defs/navigation" },
    {
      "title": "Legacy root array",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/group" }
    }
  ],
  "$defs": {
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groups"],
      "properties": {
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/group" }
        }
      }
    },
    "destination": {
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)" },
        "url": { "type": "string", "minLength": 1 }
      },
      "not": { "required": ["path", "url"] }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "items"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^(?!/)" },
        "url": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/node" }
        }
      },
      "allOf": [{ "$ref": "#/$defs/destination" }]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^(?!/)" },
        "url": { "type": "string", "minLength": 1 },
        "sidebar_children": { "type": "boolean" },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/node" }
        }
      },
      "allOf": [
        { "$ref": "#/$defs/destination" },
        { "anyOf": [{ "required": ["path"] }, { "required": ["url"] }, { "required": ["children"] }] }
      ]
    }
  }
}
